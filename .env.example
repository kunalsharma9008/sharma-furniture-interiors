# Use a long private password for the admin page.
ADMIN_PASSWORD=replace-this-with-a-private-password
# A random 32+ character secret used to sign the admin session cookie.
ADMIN_SESSION_SECRET=replace-this-with-a-random-secret

# Google Apps Script web app URL and matching script property.
INQUIRY_WEB_APP_URL=
INQUIRY_WEB_APP_SECRET=replace-with-a-long-random-secret
